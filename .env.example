# =============================================================================
# Ameriabank vPOS — integration test configuration
#
# Copy to .env and fill in with credentials from the bank. Never commit .env.
# Obtain sandbox access via vpos.support@ameriabank.am.
# =============================================================================

AMERIA_ENVIRONMENT=test

AMERIA_CLIENT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=

# Bank-assigned OrderID range. Integration tests refuse to allocate outside it.
AMERIA_ORDER_ID_START=
AMERIA_ORDER_ID_END=

# The sandbox pins the amount to a fixed value; other amounts are declined.
AMERIA_TEST_AMOUNT=10
AMERIA_TEST_CURRENCY=051

AMERIA_BACK_URL=http://localhost:8910/callback.php

# Test card, for manual entry on the payment page. The SDK never handles PAN.
AMERIA_TEST_CARD_NUMBER=
AMERIA_TEST_CARD_HOLDER=
AMERIA_TEST_CARD_EXPIRY=
AMERIA_TEST_CARD_CVV=